{
    "version": "3.0.1.11",
    "description": "微信输入法",
    "homepage": "https://z.weixin.qq.com/",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://download.z.weixin.qq.com/app/win/WeTypeSetup_3.0.1.11_3.exe",
            "hash": "62c5fe6916639762e018c75623cf3f584791add35298e56cd333e35ce5f1e594"
        }
    },
    "checkver": {
        "script": [
            "$pkg = 't/Tencent/WeType'",
            "$names = gh api \"repos/microsoft/winget-pkgs/contents/manifests/$pkg\" --jq '.[].name'",
            "$version = $names | Where-Object { $_ -match '^[0-9]' } | Sort-Object { [version]$_ } | Select-Object -Last 1",
            "$yaml = (gh api -H 'Accept: application/vnd.github.raw' \"repos/microsoft/winget-pkgs/contents/manifests/$pkg/$version/Tencent.WeType.installer.yaml\") -join \"`n\"",
            "$url = [regex]::Match($yaml, 'Architecture: x64[\\s\\S]*?InstallerUrl:\\s*(\\S+)').Groups[1].Value",
            "Write-Output \"$version|$url\""
        ],
        "regex": "([\\d.]+)\\|(https?://\\S+)",
        "replace": "${1}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$match2",
                "hash": {
                    "mode": "download"
                }
            }
        }
    }
}
