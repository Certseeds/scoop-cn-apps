{
    "version": "3.11.8",
    "description": "腾讯文档",
    "homepage": "https://docs.qq.com/",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://desktop.docs.qq.com/update/release/3.11.8/TencentDocs3.11.8.x64.30002.exe",
            "hash": "c793a7fff0f64e085c0f90265c2f230d1a1ae794b70905ec4a6ebc9888d0d0a5"
        }
    },
    "checkver": {
        "script": [
            "$pkg = 't/Tencent/TencentDocs'",
            "$names = gh api \"repos/microsoft/winget-pkgs/contents/manifests/$pkg\" --jq '.[].name'",
            "$version = $names | Where-Object { $_ -match '^[0-9]' } | Sort-Object { [version]$_ } | Select-Object -Last 1",
            "$yaml = (gh api -H 'Accept: application/vnd.github.raw' \"repos/microsoft/winget-pkgs/contents/manifests/$pkg/$version/Tencent.TencentDocs.installer.yaml\") -join \"`n\"",
            "$url = [regex]::Match($yaml, 'Architecture: x64[\\s\\S]*?InstallerUrl:\\s*(\\S+)').Groups[1].Value",
            "Write-Output \"$version|$url\""
        ],
        "regex": "([\\d.]+)\\|(https?://\\S+)",
        "replace": "${1}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$match2",
                "hash": {
                    "mode": "download"
                }
            }
        }
    }
}
