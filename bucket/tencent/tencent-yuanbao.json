{
    "version": "2.89.0",
    "description": "腾讯元宝",
    "homepage": "https://yuanbao.tencent.com/",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://cdn-hybrid-prod.hunyuan.tencent.com/Desktop/official/54a86f32e33b8d8cbbadf3f1e1943822/yuanbao_2.89.0.612_x64.exe",
            "hash": "83f42b12f6723cfc680d99d16d13427c569f8d9abbc1b175f53a7c157dceb846"
        }
    },
    "checkver": {
        "script": [
            "$pkg = 't/Tencent/Yuanbao'",
            "$names = gh api \"repos/microsoft/winget-pkgs/contents/manifests/$pkg\" --jq '.[].name'",
            "$version = $names | Where-Object { $_ -match '^[0-9]' } | Sort-Object { [version]$_ } | Select-Object -Last 1",
            "$yaml = (gh api -H 'Accept: application/vnd.github.raw' \"repos/microsoft/winget-pkgs/contents/manifests/$pkg/$version/Tencent.Yuanbao.installer.yaml\") -join \"`n\"",
            "$url = [regex]::Match($yaml, 'Architecture: x64[\\s\\S]*?InstallerUrl:\\s*(\\S+)').Groups[1].Value",
            "Write-Output \"$version|$url\""
        ],
        "regex": "([\\d.]+)\\|(https?://\\S+)",
        "replace": "${1}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$match2",
                "hash": {
                    "mode": "download"
                }
            }
        }
    }
}
